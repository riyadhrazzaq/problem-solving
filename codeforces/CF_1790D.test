-- Tourists Solution
int main() {
  ios::sync_with_stdio(false);
  cin.tie(0);
  int tt;
  cin >> tt;
  while (tt--) {
    int n;
    cin >> n;
    vector<int> a(n);
    map<int, int> mp;
    for (int i = 0; i < n; i++) {
      cin >> a[i];
      mp[a[i]] += 1;
    }
    int ans = n;
    int last = -1;
    int cnt = 0;
    for (auto& p : mp) {
      if (p.first == last + 1) {
        ans -= min(p.second, cnt);
      }
      last = p.first;
      cnt = p.second;
    }
    cout << ans << '\n';
  }
  return 0;
}

-- Psuedo of Tourist
a <- array
n <- size of a
mp <- frequency distribution of a
ans <- n // at the beginning all element of the array is a set of one
last <- -1
freq <- 0
// iterater over mp, sorted on key
for k, v in mp:
    // this if clause is like tetris
    if k == last+1:
       ans = ans - min(cnt, v)
    last = k
    freq = v
