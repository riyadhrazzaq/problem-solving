solve(a[], b[], k):
    if k == 0, return sum(a)
    else:
        a= sort(a, asc)
        b = sort(b, desc)
        i = 0, j = 0
        while k-- && (a[i] < b[j]) > 0
           swap(a[i], b[j])
           i++
           j++

Tourist's Solution
int main() {
  ios::sync_with_stdio(false);
  cin.tie(0);
  int tt;
  cin >> tt;
  while (tt--) {
    int n, s, r;
    cin >> n >> s >> r;
    vector<int> a(n, s - r);
    int cur = n * (s - r) - s;
    for (int i = 0; i < n; i++) {
      int take = min(a[i] - 1, cur);
      a[i] -= take;
      cur -= take;
    }
    for (int i = 0; i < n; i++) {
      cout << a[i] << " \n"[i == n - 1];
    }
  }
  return 0;
}
