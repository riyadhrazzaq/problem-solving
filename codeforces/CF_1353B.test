solve(a[], b[], k):
    if k == 0, return sum(a)
    else:
        a= sort(a, asc)
        b = sort(b, desc)
        i = 0, j = 0
        while k-- && (a[i] < b[j]) > 0
           swap(a[i], b[j])
           i++
           j++
